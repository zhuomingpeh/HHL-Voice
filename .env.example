# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.
#
# Local dev and production both use Neon Postgres (via the Vercel Marketplace
# integration). Get the local values with:
#   npx vercel env pull .env.local
# (requires `npx vercel link` first — this project is already linked to
# loanify/hhl-voice). That also pulls DATABASE_URL_UNPOOLED, used by Prisma
# Migrate for DDL (Neon's pooled connection doesn't support it reliably).

# --- Database (Neon) ---
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- Twilio ---
# Leave blank for local/test use. Calling features are disabled until these are set.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- OpenAI ---
OPENAI_API_KEY=

# --- App ---
# Public base URL Twilio webhooks call back to (e.g. your Vercel deployment URL, or an ngrok tunnel for local dev).
APP_BASE_URL="http://localhost:3000"
