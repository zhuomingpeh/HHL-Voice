# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real credentials.

# --- Database ---
# Local dev: SQLite, zero config.
DATABASE_URL="file:./dev.db"
# Production (Vercel): Postgres connection string, e.g. from Vercel Postgres / Neon.
# DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# --- Twilio ---
# Leave blank for local/test use. Calling features are disabled until these are set.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=

# --- OpenAI ---
OPENAI_API_KEY=

# --- App ---
# Public base URL Twilio webhooks call back to (e.g. your Vercel deployment URL, or an ngrok tunnel for local dev).
APP_BASE_URL="http://localhost:3000"
