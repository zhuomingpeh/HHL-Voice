// Prisma schema for the AI Debt Reminder Calling System.
//
// Postgres (Neon, via the Vercel Marketplace integration). Local dev uses
// Neon's "development" branch (pulled into .env.local by `vercel env pull` /
// `vercel link`); production uses the "production" branch, set as Vercel
// project env vars. directUrl (unpooled) is used for migrations, since DDL
// over Neon's pooled/PgBouncer connection is unreliable.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum BatchStatus {
  DRAFT // uploaded, not yet validated
  VALIDATED // validated, ready to call
  RUNNING // calling in progress
  PAUSED // staff paused the batch
  COMPLETED // all records processed
}

// Call outcomes are intentionally NOT a Prisma enum. The spec calls these
// "temporary" categories that will be renamed/merged/split after real-world
// usage, and changing a Prisma enum requires a migration + backfill for
// every historical row. Valid values are governed at the application layer
// in src/lib/callOutcomes.ts and only loosely constrained here.
model Batch {
  id            String   @id @default(cuid())
  filename      String
  uploadedAt    DateTime @default(now())
  status        BatchStatus @default(DRAFT)

  totalRows     Int      @default(0)
  validRows     Int      @default(0)
  invalidRows   Int      @default(0)

  // Configurable public-holiday advance-call rule snapshot for this batch,
  // e.g. { "advanceDays": 1, "holidays": ["2026-01-01", ...] }. Kept per
  // batch so past batches remain auditable even if the config changes later.
  callSchedulingConfig Json?

  records CustomerRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CustomerRecord {
  id        String   @id @default(cuid())
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId   String

  rowNumber Int // 1-based row number in the source CSV, for error reporting

  // Raw CSV fields (source of truth for this calling batch)
  name           String
  phoneNumberRaw String
  phoneNumberE164 String? // normalized, null if it couldn't be parsed
  dueDate        DateTime
  remarks        String?

  // Outstanding amount, ONLY populated when unambiguously extractable from
  // Remarks. Never inferred, calculated, or guessed. Null means "unknown" —
  // the AI must never state an amount in that case.
  outstandingAmount Decimal?

  isValid          Boolean  @default(false)
  validationErrors Json? // string[] of validation error messages

  calls           Call[]
  callbackTasks   CallbackTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([batchId])
  @@index([phoneNumberE164])
}

model Call {
  id               String   @id @default(cuid())
  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  customerRecordId String

  twilioCallSid String?

  startTime DateTime?
  endTime   DateTime?
  durationSeconds Int?

  wasAnswered Boolean?

  // Free-text outcome key, validated against src/lib/callOutcomes.ts at the
  // application layer (see comment on Batch above).
  outcome String?

  identityConfirmed Boolean @default(false)

  callSummary String?
  transcript  Json? // array of { role, text, timestamp }

  promiseToPayRaw        String? // original customer wording, verbatim
  promiseToPayNormalized DateTime? // best-effort parsed date/time

  paymentInstructionsRequested Boolean @default(false)
  paymentInstructionsSent      Boolean @default(false)

  callbackRequired Boolean @default(false)
  callbackReason   String?

  errorMessage String?

  recordingUrl        String? // Twilio recording media URL (set once recordingStatusCallback fires)
  recordingDurationSec Int?

  callbackTasks CallbackTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRecordId])
  @@index([twilioCallSid])
}

// Singleton row (fixed id) holding the AI caller's configurable voice + script
// text, editable from the dashboard. Deliberately narrow: the compliance-
// critical branch logic and strict rules (no negotiation, no invented
// amounts, escalate-when-upset, etc.) stay hardcoded in src/lib/systemPrompt.ts
// rather than becoming free text here — only the caller-facing wording and
// voice tuning are meant to be staff-editable.
model AgentSettings {
  id String @id @default("singleton")

  // ElevenLabs voice + tuning. voiceId defaults to ELEVENLABS_VOICE_ID (the
  // cloned voice) the first time settings are read — see src/lib/agentSettings.ts.
  voiceId              String
  voiceName            String?
  voiceStability       Float   @default(0.5)
  voiceSimilarityBoost Float   @default(0.75)
  voiceStyle           Float   @default(0)
  voiceSpeakerBoost    Boolean @default(true)
  // ElevenLabs speed multiplier. 1.0 = unadjusted; clamped to 0.7-1.2 at the
  // application layer (the API technically allows 0.25-4.0, but quality
  // degrades noticeably outside the narrower range).
  voiceSpeed           Float   @default(1.0)

  // Caller-facing script text. openingLine is played as fixed Twilio <Say>
  // TwiML before the AI connects (see voice/route.ts) and is also quoted
  // back to the model in its system prompt so it knows what was already
  // said; voicemailMessage plays as a one-way message when AMD detects a
  // machine.
  openingLine      String @default("Hi this is HHL Credit, your payment is due today. Will payment be made today?")
  voicemailMessage String @default("Hi, this is an automated call from HHL Credit regarding a payment reminder. Please call us back at your convenience. Thank you.")

  // Background info fed to the AI as context (company policy, tone notes,
  // etc.) — never read aloud, and explicitly non-authoritative over the
  // strict rules/branch logic in systemPrompt.ts. Free text, staff-editable.
  additionalContext String @default("")

  updatedAt DateTime @updatedAt
}

enum CallbackTaskStatus {
  OPEN
  COMPLETED
}

model CallbackTask {
  id String @id @default(cuid())

  customerRecord   CustomerRecord @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  customerRecordId String

  call   Call?   @relation(fields: [callId], references: [id], onDelete: SetNull)
  callId String?

  reason           String
  summary          String?
  customerStatement String?

  status      CallbackTaskStatus @default(OPEN)
  completedAt DateTime?
  completedBy String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRecordId])
  @@index([status])
}
